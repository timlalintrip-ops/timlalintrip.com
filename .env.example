# Copy to .env.local for local development, or add in Vercel:
# Project Settings → Environment Variables. Never commit real values.
# These are read on the server only — never prefix them with NEXT_PUBLIC_.
#
# Until all three are set, the booking form shows that online enquiries are
# not active and no submission is accepted.

# Gmail address that sends the booking notification (the visitor never sets the sender).
GMAIL_USER=

# Google App Password for GMAIL_USER (16 characters; spaces are ignored).
# Create it in the Google account settings — never use the normal Gmail password.
GMAIL_APP_PASSWORD=

# Inbox that receives booking enquiries.
BOOKING_TO_EMAIL=timlalintrip@gmail.com
